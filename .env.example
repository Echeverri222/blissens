# Copiado a .env por `make setup`. Solo valores locales; nada secreto.
ENTORNO=local
# Rol de la aplicación (sin privilegios: la base le aplica el aislamiento por negocio)
DATABASE_URL=postgresql://estudia_app:estudia_app@127.0.0.1:5433/estudia
# Rol administrador (migraciones, CLI de usuarios y negocios)
DATABASE_URL_ADMIN=postgresql://estudia:estudia@127.0.0.1:5433/estudia
TEST_DATABASE_URL=postgresql://estudia_app:estudia_app@127.0.0.1:5433/estudia_test
BASE_URL=http://localhost:8000
SECRET_KEY=cambia-esto-en-cualquier-despliegue
# SECRET_KEY_ANTERIOR=   # para rotar la clave sin invalidar enlaces vigentes
NEGOCIO_POR_DEFECTO=blissens
# TICK_SECRETO=          # exigido en demo/produccion para /tick
DATOS_REALES_DIR=datos_reales
# ANTHROPIC_API_KEY=     # activa el asistente; sin ella sus rutas no existen
# ASISTENTE_MODELO=claude-opus-5-5
# ASISTENTE_MODELO_PACIENTE=   # por defecto, el mismo
# ASISTENTE_PROVEEDOR=bedrock  # el modelo en Amazon Bedrock en vez de la API de Claude (sin ANTHROPIC_API_KEY)
# AWS_REGION=us-east-1         # región de Bedrock; credenciales: `aws login`/perfil, variables AWS_*, o AWS_BEARER_TOKEN_BEDROCK
# AWS_PROFILE=blissens         # perfil de ~/.aws si no es el default (p. ej. tras `aws login --profile blissens`)
